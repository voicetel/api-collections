meta {
  name: ACL · Remove entry
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v2.2/acl
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
{
  "acl": [
    {
      "cidr": "203.0.113.0/24"
    }
  ]
}
}

docs {
**Remove IP ACL entries**
Removes ACL entries. Accepts the same {acl: [{cidr}]} body as POST /v2.2/acl. Entries that do not exist fail individually.

Returns **200 OK** with a JSON body (not 204).

OperationId: `aclDelete`
}
